# === Telegram Bot ===
BOT_TOKEN=123456:ABC-your-bot-token-here
ADMIN_IDS=123456789,987654321          # vergul bilan ajratilgan admin ID'lar

# === Narx sozlamalari ===
# 1 Star narxi. Bu boshlang'ich qiymat — keyin admin panel (⚙️ Narx va referal
# sozlamalari) orqali bot ichidan o'zgartirish mumkin, u .env dan ustun turadi.
PRICE_PER_STAR=200                     # 1 Star narxi (so'mda)
MIN_STARS=50                           # minimal buyurtma
MAX_STARS=100000                       # maksimal buyurtma

# === Referal ===
# Admin panelda "referal Stars" > 0 qilinsa, foiz o'rniga Stars asosida mukofot beriladi.
REFERRAL_BONUS_PERCENT=5               # (zaxira) referal foizi — Stars 0 bo'lsa ishlatiladi

# === To'lov: Click ===
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

# === To'lov: Payme ===
PAYME_MERCHANT_ID=
PAYME_KEY=                             # Payme kassa kaliti (webhook auth uchun)

# === Webhook server (Click/Payme callback) ===
WEBHOOK_PORT=8080

# === To'lov: TON (qabul qilish) ===
TON_WALLET_ADDRESS=                    # to'lovlar keladigan TON hamyon manzili (EQ...)
USD_UZS_RATE=12800                     # 1 USD = ? so'm (TON kursini hisoblash uchun)
TON_UZS_FALLBACK=42000                 # kurs API ishlamasa, 1 TON = ? so'm
TON_CHECK_MINUTES=30                   # TON to'lovni kutish vaqti (daqiqa)

# === Fragment / Stars yetkazish ===
FRAGMENT_MODE=fragment                 # manual | fragment
#   manual   -> adminga xabar, qo'lda yuboriladi (kalit kerak emas)
#   fragment -> cookie + seed orqali AVTOMATIK sotib oladi

# TON hamyon seed (12 yoki 24 so'z) — Stars uchun to'lov SHU hamyondan yechiladi.
# Hamyonda yetarli TON bo'lishi shart.
TON_WALLET_MNEMONIC=                    # "word1 word2 ... word24"
TON_API_KEY=                            # toncenter.com API kaliti (ixtiyoriy)

# Fragment cookie'lari:
#   1) Brauzerda https://fragment.com ga kiring, Telegram orqali login qiling
#   2) TON hamyoningizni ulang (Connect TON)
#   3) DevTools (F12) -> Application -> Cookies -> fragment.com dan quyidagilarni oling:
FRAGMENT_STEL_TOKEN=
FRAGMENT_STEL_SSID=
FRAGMENT_STEL_DT=
FRAGMENT_STEL_TON_TOKEN=

# Fragment to'lovida hamyondan nima yechiladi: ton | usdt
FRAGMENT_PAY_CURRENCY=ton
# Hamyon versiyasi: v4r2 | v5r1 (W5). Tonkeeper yangi hamyonlar odatda v5r1 (W5).
# Admin panel -> Akkaunt ulash -> 🪙 Hamyon versiyasi orqali ham almashtiriladi.
WALLET_VERSION=v5r1

# === Telegram akkaunt (telefon raqam orqali ulash — Telethon) ===
# my.telegram.org -> API development tools dan olinadi (bepul)
TG_API_ID=
TG_API_HASH=
TG_SESSION=                             # (ixtiyoriy) python -m bot.login dan olingan session string
# Eslatma: bularni admin panel orqali ham kiritish mumkin (/admin -> 🔗 Akkaunt ulash -> 📱)

# === AVTO KARTA TO'LOVI ("Aniq summa + Telegram bildirishnomasi") ===
# Shu SESSION kartaga ulangan Telegram akkaunt bo'lsin — bank bildirishnomalari
# (@ClickUz, @payme, @humocardbot, bank SMS->Telegram) shu akkauntga kelsin.
# Bot ularni tinglab, aniq noyob summaga mos pending to'lovni topib balans qo'shadi.
CARD_NUMBER=                            # pul tushadigan karta raqami (userga ko'rsatiladi)
CARD_HOLDER=                            # karta egasi ismi (ixtiyoriy)
BANK_SENDERS=                           # vergul bilan, @siz: ClickUz,payme,humocardbot (bo'sh=hamma)
CARD_TOPUP_MINUTES=15                   # noyob summa necha daqiqa amal qiladi
# Eslatma: karta va bank yuboruvchilarni admin panel orqali ham sozlash mumkin
# (/admin -> ⚙️ Narx va referal sozlamalari).

# ESLATMA: seed va cookie'larni .env o'rniga BOT ichidagi admin panel orqali ham
# ulashingiz mumkin (/admin -> 🔗 Akkaunt ulash). Admin paneldagi qiymat .env dan ustun.
