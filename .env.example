# === Telegram Bot ===
BOT_TOKEN=123456:ABC-your-bot-token-here
ADMIN_IDS=123456789,987654321          # vergul bilan ajratilgan admin ID'lar

# === Narx sozlamalari ===
PRICE_PER_STAR=200                     # 1 Star narxi (so'mda), masalan 200 so'm
MIN_STARS=50                           # minimal buyurtma
MAX_STARS=100000                       # maksimal buyurtma

# === Referal ===
REFERRAL_BONUS_PERCENT=5               # referaldan tushgan buyurtmadan necha % bonus

# === To'lov: Click ===
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

# === To'lov: Payme ===
PAYME_MERCHANT_ID=
PAYME_KEY=                             # Payme kassa kaliti (webhook auth uchun)

# === Webhook server (Click/Payme callback) ===
WEBHOOK_PORT=8080

# === To'lov: TON (qabul qilish) ===
TON_WALLET_ADDRESS=                    # to'lovlar keladigan TON hamyon manzili (EQ...)
USD_UZS_RATE=12800                     # 1 USD = ? so'm (TON kursini hisoblash uchun)
TON_UZS_FALLBACK=42000                 # kurs API ishlamasa, 1 TON = ? so'm
TON_CHECK_MINUTES=30                   # TON to'lovni kutish vaqti (daqiqa)

# === Fragment / Stars yetkazish ===
FRAGMENT_MODE=fragment                 # manual | fragment
#   manual   -> adminga xabar, qo'lda yuboriladi (kalit kerak emas)
#   fragment -> cookie + seed orqali AVTOMATIK sotib oladi

# TON hamyon seed (12 yoki 24 so'z) — Stars uchun to'lov SHU hamyondan yechiladi.
# Hamyonda yetarli TON bo'lishi shart.
TON_WALLET_MNEMONIC=                    # "word1 word2 ... word24"
TON_API_KEY=                            # toncenter.com API kaliti (ixtiyoriy)

# Fragment cookie'lari:
#   1) Brauzerda https://fragment.com ga kiring, Telegram orqali login qiling
#   2) TON hamyoningizni ulang (Connect TON)
#   3) DevTools (F12) -> Application -> Cookies -> fragment.com dan quyidagilarni oling:
FRAGMENT_STEL_TOKEN=
FRAGMENT_STEL_SSID=
FRAGMENT_STEL_DT=
FRAGMENT_STEL_TON_TOKEN=

# Fragment to'lovida hamyondan nima yechiladi: ton | usdt
FRAGMENT_PAY_CURRENCY=ton

# ESLATMA: seed va cookie'larni .env o'rniga BOT ichidagi admin panel orqali ham
# ulashingiz mumkin (/admin -> 🔗 Akkaunt ulash). Admin paneldagi qiymat .env dan ustun.
